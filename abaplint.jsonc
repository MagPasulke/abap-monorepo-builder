    "exit_or_check": {
      "exclude": [],
      "severity": "Error",
      "allowExit": false,
      "allowCheck": false
    },
    "expand_macros": {
      "exclude": [],
      "severity": "Error"
    },
    "exporting": {
      "exclude": [],
      "severity": "Error"
    },
    "final_newline": {
      "exclude": [],
      "severity": "Error"
    },
    "fm_global_parameters_obsolete": {
      "exclude": [],
      "severity": "Error"
    },
    "forbidden_identifier": {
      "exclude": [],
      "severity": "Error",
      "check": []
    },
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "severity": "Error",
      "pseudo": [
        "\"#EC *"
      ],
      "pragmas": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false
